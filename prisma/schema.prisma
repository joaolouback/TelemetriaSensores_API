// Schema do projeto UVV Go
// Modelado a partir do diagrama de classes do TCC.
// Banco: PostgreSQL | ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Perfil do usuário. No diagrama, Administrador herda de Usuario;
/// aqui a distinção é feita pelo campo `role` (herança de tabela única).
enum Role {
  ESTUDANTE
  ADMINISTRADOR
}

model Usuario {
  id             Int      @id @default(autoincrement())
  nome           String   @db.VarChar(120)
  email          String   @unique @db.VarChar(160)
  senhaHash      String   @map("senha_hash") @db.VarChar(255)
  role           Role     @default(ESTUDANTE)
  pontuacaoTotal Int      @default(0) @map("pontuacao_total")
  dataCadastro   DateTime @default(now()) @map("data_cadastro")

  interacoes  Interacao[]
  conquistas  UsuarioConquista[]
  ranking     Ranking?
  telemetrias TelemetriaSensor[]

  @@map("usuarios")
}

/// Ponto de coleta no campus (Prédio Azul, Biblioteca, Capela...).
/// `raioGeofence` em metros define a cerca virtual de validação.
model PontoDeInteresse {
  id               Int      @id @default(autoincrement())
  nome             String   @db.VarChar(120)
  descricao        String?  @db.Text
  latitude         Float
  longitude        Float
  raioGeofence     Float    @default(30) @map("raio_geofence")
  pontosRecompensa Int      @default(10) @map("pontos_recompensa")
  ativo            Boolean  @default(true)
  criadoEm         DateTime @default(now()) @map("criado_em")

  objeto3d   Objeto3D?
  interacoes Interacao[]

  @@map("pontos_interesse")
}

/// Modelo 3D renderizado via ARCore ao alcançar o ponto.
model Objeto3D {
  id       Int    @id @default(autoincrement())
  nome     String @db.VarChar(120)
  assetUrl String @map("asset_url") @db.VarChar(500)
  formato  String @default("glb") @db.VarChar(20)
  escala   Float  @default(1)

  pontoId Int              @unique @map("ponto_id")
  ponto   PontoDeInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)

  @@map("objetos_3d")
}

/// Registro de um usuário alcançando um ponto de coleta.
/// `validadoGeofence` guarda se o backend confirmou a proximidade.
model Interacao {
  id                Int      @id @default(autoincrement())
  dataHora          DateTime @default(now()) @map("data_hora")
  latitudeRegistro  Float    @map("latitude_registro")
  longitudeRegistro Float    @map("longitude_registro")
  distanciaMetros   Float?   @map("distancia_metros")
  validadoGeofence  Boolean  @default(false) @map("validado_geofence")
  pontosGanhos      Int      @default(0) @map("pontos_ganhos")

  usuarioId Int              @map("usuario_id")
  usuario   Usuario          @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  pontoId   Int              @map("ponto_id")
  ponto     PontoDeInteresse @relation(fields: [pontoId], references: [id], onDelete: Cascade)

  @@index([usuarioId])
  @@index([pontoId])
  @@map("interacoes")
}

/// Medalha/conquista desbloqueável.
model Conquista {
  id                Int    @id @default(autoincrement())
  titulo            String @db.VarChar(120)
  descricao         String @db.Text
  iconeUrl          String? @map("icone_url") @db.VarChar(500)
  pontosNecessarios Int    @default(0) @map("pontos_necessarios")

  usuarios UsuarioConquista[]

  @@map("conquistas")
}

/// Tabela de junção: qual usuário desbloqueou qual conquista e quando.
model UsuarioConquista {
  usuarioId     Int      @map("usuario_id")
  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conquistaId   Int      @map("conquista_id")
  conquista     Conquista @relation(fields: [conquistaId], references: [id], onDelete: Cascade)
  desbloqueadaEm DateTime @default(now()) @map("desbloqueada_em")

  @@id([usuarioId, conquistaId])
  @@map("usuarios_conquistas")
}

/// Classificação do usuário. Uma linha por usuário (0..1 no diagrama).
model Ranking {
  id           Int      @id @default(autoincrement())
  posicao      Int
  pontuacao    Int      @default(0)
  atualizadoEm DateTime @default(now()) @updatedAt @map("atualizado_em")

  usuarioId Int     @unique @map("usuario_id")
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("rankings")
}

/// Telemetria de sensores herdada da POC (GPS, acelerômetro, bateria, rede).
/// Substitui a tabela `sensor_logs` do MySQL. `usuarioId` é opcional para
/// manter compatibilidade com coletas anônimas do app atual.
model TelemetriaSensor {
  id           Int      @id @default(autoincrement())
  sensorType   String   @default("UNKNOWN") @map("sensor_type") @db.VarChar(50)
  latitude     Float?
  longitude    Float?
  accelX       Float?   @map("accel_x")
  accelY       Float?   @map("accel_y")
  accelZ       Float?   @map("accel_z")
  magnitude    Float?
  batteryLevel Float?   @map("battery_level")
  networkType  String?  @map("network_type") @db.VarChar(50)
  synced       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")

  usuarioId Int?     @map("usuario_id")
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([usuarioId])
  @@map("telemetria_sensores")
}
